# ---------------------------------------------------------------------------
# Softdial Studio — Supabase Edge Function secrets
#
# These are SERVER-side secrets. They are never bundled into the browser.
# Set them with:  supabase secrets set --env-file supabase/.env
# ---------------------------------------------------------------------------

# --- Supabase (injected automatically in deployed functions; needed locally) --
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telnyx -----------------------------------------------------------------
# API key from Telnyx Portal → API Keys
TELNYX_API_KEY=

# Application ID of your Voice API / Call Control Application — NOT the SIP
# connection ID. See docs/guides/telnyx-call-control-setup.md.
# Legacy alias TELNYX_CALL_CONTROL_CONNECTION_ID is still read as a fallback.
TELNYX_CONNECTION_ID=

# SIP credential connection ID, used to mint WebRTC credentials for click-to-dial.
TELNYX_CREDENTIAL_CONNECTION_ID=

# Shared secret used to verify inbound Telnyx webhook signatures.
TELNYX_WEBHOOK_SECRET=

# --- Upstash Redis (parallel-dialer session state) --------------------------
# Legacy aliases REDIS_URL / REDIS_TOKEN are still read as fallbacks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Feature flags ----------------------------------------------------------
# Must be "true" for the dialer-session-start function to accept requests.
PARALLEL_DIALER_ENABLED=true

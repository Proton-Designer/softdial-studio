# ---------------------------------------------------------------------------
# Softdial Studio — web client environment
# Copy to `.env` and fill in. Never commit the filled-in file.
# Only VITE_-prefixed variables are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; RLS enforces access)
# Dashboard → Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=

# Feature flag for the parallel dialer UI.
# Set to "false" to hide parallel-dial actions. Any other value (or unset) enables it.
VITE_PARALLEL_DIALER_ENABLED=true
